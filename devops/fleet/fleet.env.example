# Settings for the planner fleet. The SAME file serves two readers:
#   - planner-ctl.sh, via systemd:   sudo cp fleet.env.example /etc/planner-fleet.env
#   - the admin page's compose file: cp fleet.env.example devops/fleet/.env
# (the admin page only reads the FLEET_*, PUBLIC_IP and ADMIN_SITE lines).

# New planners are <subdomain>.FLEET_DOMAIN. Its DNS A record is made by hand,
# before adding the planner; planner-ctl.sh checks it points at PUBLIC_IP.
FLEET_DOMAIN=example.com
PUBLIC_IP=203.0.113.10

# Registry (planners.tsv), requests, job status and logs.
FLEET_HOME=/home/ubuntu/planner-fleet
# New planners go to FLEET_BASE_DIR/<name>_planner_ws, copied from FLEET_TEMPLATE.
FLEET_BASE_DIR=/home/ubuntu
FLEET_TEMPLATE=/home/ubuntu/project_planner_ws
# The checkout whose devops/docker/.env holds PLAN_SITES and runs compose.edge.yml.
FLEET_EDGE_CHECKOUT=/home/ubuntu/project_planner_ws
# Written into each new planner's .env, so its boards offer release updates.
PLAN_UPDATE_DIR=/home/ubuntu/planner-updates

# The admin page itself: hostname=port, added to PLAN_SITES like a planner.
ADMIN_SITE=plans.example.com=8090
# The root user "admin" is created with this password on the admin page's
# FIRST start; after that it is changed from the page (users.json holds the
# hashes). Only needed in devops/fleet/.env, not in /etc.
FLEET_ADMIN_PASSWORD=
# Optional: an address for Let's Encrypt expiry notices.
# CERT_EMAIL=
