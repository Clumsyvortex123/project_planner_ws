# /etc/planner-updater.env — read by planner-updater.service.
RELEASE_REPO=Clumsyvortex123/project_planner_ws
UPDATE_DIR=/home/ubuntu/planner-updates
# Every planner checkout on this box, space-separated. All of them get the release.
CHECKOUTS="/home/ubuntu/ubr_planner_ws /home/ubuntu/project_planner_ws"
BACKUP_DIR=/home/ubuntu/backups
KEEP_BACKUPS=10
