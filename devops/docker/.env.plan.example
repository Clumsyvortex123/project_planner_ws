# devops/docker/.env for the plan box (compose.plan.yml).
#
# Copy this to .env in the same directory and fill it in:
#   cp .env.plan.example .env
#
# Read at container CREATION, not at start: after editing this, `up -d
# --force-recreate` — `restart` will keep the old values and nothing will say so.

# This box's public hostname. nginx renders it into both server blocks AND into
# the certificate paths, so a blank value produces a config matching no request.
PLAN_SERVER_NAME=

# Where the edge sends everything. The default is the compose service, and the
# port is the container's, not the published one. Override only to point the
# edge at something else on the network.
PLAN_UI_UPSTREAM=plan-ui:80

# Where the edge sends /api/ — the shared plan store.
PLAN_API_UPSTREAM=plan-api:3000

# Loopback publishes, so both can be curled from the box (and the app used
# directly on a box with no certificate). Not reachable off-box.
PLAN_UI_HOST_PORT=8080
PLAN_API_HOST_PORT=3001
