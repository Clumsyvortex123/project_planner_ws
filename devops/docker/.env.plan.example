# devops/docker/.env for one checkout (compose.plan.yml, and compose.edge.yml if
# this checkout also runs the box's edge).
#
# Copy this to .env in the same directory and fill it in:
#   cp .env.plan.example .env
#
# Read at container CREATION, not at start: after editing this, `up -d
# --force-recreate` — `restart` will keep the old values and nothing will say so.

# ── This planner (compose.plan.yml) ─────────────────────────────────────────
# Unique per planner on the box: containers become <name>-api / <name>-ui and
# the volume <name>_plan_data. Leave it unset only for the box's original
# planner, which keeps project `docker` and containers plan-api / plan-ui.
COMPOSE_PROJECT_NAME=osmos

# The loopback port this planner answers on (the board and its /api/). Unique
# per planner on the box; PLAN_SITES below maps a hostname to it. Not reachable
# off-box except through the edge.
PLAN_PORT=8081

# ── The box's edge (compose.edge.yml) ───────────────────────────────────────
# Only read by the checkout that runs the edge; ignored everywhere else.
# hostname=port for EVERY planner on the box, space-separated. A hostname with
# no certificate yet is served on :80 (ACME) only, so it can be issued — see
# devops/README.md.
PLAN_SITES="ubr.neuralpilot-dev.com=8080 osmos.neuralpilot-dev.com=8081"
